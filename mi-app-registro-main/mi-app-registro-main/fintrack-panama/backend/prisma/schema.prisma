// This is your Prisma schema file
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── User ─────────────────────────────────────────────────────────────────────
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  incomeRecords  IncomeRecord[]
  expenses       Expense[]
  debts          Debt[]
  savingsGoals   SavingsGoal[]
  refreshTokens  RefreshToken[]
  bankAccounts   BankAccount[]
  bankDebts      BankDebt[]

  @@map("users")
}

// ─── Refresh Tokens ───────────────────────────────────────────────────────────
model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  revoked   Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ─── Income Records (Quincenas) ───────────────────────────────────────────────
model IncomeRecord {
  id                    String   @id @default(cuid())
  userId                String   @map("user_id")
  periodStart           DateTime @map("period_start")
  periodEnd             DateTime @map("period_end")
  grossAmount           Decimal  @map("gross_amount") @db.Decimal(12, 2)
  cssDeduction          Decimal  @map("css_deduction") @db.Decimal(12, 2)
  educativoDeduction    Decimal  @map("educativo_deduction") @db.Decimal(12, 2)
  ifarhuDeduction       Decimal  @default(0) @map("ifarhu_deduction") @db.Decimal(12, 2)
  otherDeductions       Decimal  @default(0) @map("other_deductions") @db.Decimal(12, 2)
  netAmount             Decimal  @map("net_amount") @db.Decimal(12, 2)
  includesIfarhu        Boolean  @default(false) @map("includes_ifarhu")
  notes                 String?
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@index([userId])
  @@index([periodStart])
  @@map("income_records")
}

// ─── Expenses ─────────────────────────────────────────────────────────────────
model Expense {
  id             String          @id @default(cuid())
  userId         String          @map("user_id")
  incomeRecordId String?         @map("income_record_id")
  category       ExpenseCategory
  amount         Decimal         @db.Decimal(12, 2)
  description    String
  date           DateTime
  type           ExpenseType     @default(VARIABLE)
  notes          String?
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  incomeRecord IncomeRecord? @relation(fields: [incomeRecordId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([date])
  @@index([category])
  @@map("expenses")
}

enum ExpenseCategory {
  ALIMENTACION
  TRANSPORTE
  SALUD
  ENTRETENIMIENTO
  SERVICIOS
  EDUCACION
  VIVIENDA
  ROPA
  TECNOLOGIA
  OTROS
}

enum ExpenseType {
  FIJO
  VARIABLE
}

// ─── Debts ────────────────────────────────────────────────────────────────────
model Debt {
  id             String    @id @default(cuid())
  userId         String    @map("user_id")
  creditorName   String    @map("creditor_name")
  totalAmount    Decimal   @map("total_amount") @db.Decimal(12, 2)
  remainingAmount Decimal  @map("remaining_amount") @db.Decimal(12, 2)
  interestRate   Decimal   @map("interest_rate") @db.Decimal(5, 4)
  monthlyPayment Decimal   @map("monthly_payment") @db.Decimal(12, 2)
  startDate      DateTime  @map("start_date")
  endDate        DateTime? @map("end_date")
  isPaid         Boolean   @default(false) @map("is_paid")
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments DebtPayment[]

  @@index([userId])
  @@map("debts")
}

model DebtPayment {
  id            String   @id @default(cuid())
  debtId        String   @map("debt_id")
  amount        Decimal  @db.Decimal(12, 2)
  principalPaid Decimal  @map("principal_paid") @db.Decimal(12, 2)
  interestPaid  Decimal  @map("interest_paid") @db.Decimal(12, 2)
  paymentDate   DateTime @map("payment_date")
  createdAt     DateTime @default(now()) @map("created_at")

  debt Debt @relation(fields: [debtId], references: [id], onDelete: Cascade)

  @@index([debtId])
  @@map("debt_payments")
}

// ─── Savings Goals ────────────────────────────────────────────────────────────
model SavingsGoal {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  name          String
  targetAmount  Decimal   @map("target_amount") @db.Decimal(12, 2)
  currentAmount Decimal   @default(0) @map("current_amount") @db.Decimal(12, 2)
  targetDate    DateTime  @map("target_date")
  isCompleted   Boolean   @default(false) @map("is_completed")
  isPrimary     Boolean   @default(false) @map("is_primary")
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions SavingsContribution[]

  @@index([userId])
  @@map("savings_goals")
}

model SavingsContribution {
  id            String   @id @default(cuid())
  savingsGoalId String   @map("savings_goal_id")
  amount        Decimal  @db.Decimal(12, 2)
  date          DateTime
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")

  savingsGoal SavingsGoal @relation(fields: [savingsGoalId], references: [id], onDelete: Cascade)

  @@index([savingsGoalId])
  @@map("savings_contributions")
}

// ─── Bank Accounts ────────────────────────────────────────────────────────────
model BankAccount {
  id          String          @id @default(cuid())
  userId      String          @map("user_id")
  bankName    String          @map("bank_name")
  accountType BankAccountType @map("account_type")
  balance     Decimal         @default(0) @db.Decimal(12, 2)
  currency    String          @default("USD")
  alias       String?
  isPrimary   Boolean         @default(false) @map("is_primary")
  isActive    Boolean         @default(true) @map("is_active")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankDebts BankDebt[]

  @@index([userId])
  @@map("bank_accounts")
}

enum BankAccountType {
  CORRIENTE
  AHORROS
  INVERSION
}

// ─── Bank Debts ───────────────────────────────────────────────────────────────
model BankDebt {
  id                String        @id @default(cuid())
  userId            String        @map("user_id")
  bankAccountId     String?       @map("bank_account_id")
  debtType          BankDebtType  @map("debt_type")
  creditorBank      String        @map("creditor_bank")
  originalAmount    Decimal       @map("original_amount") @db.Decimal(12, 2)
  remainingBalance  Decimal       @map("remaining_balance") @db.Decimal(12, 2)
  annualRate        Decimal       @map("annual_rate") @db.Decimal(6, 4)
  monthlyPayment    Decimal       @map("monthly_payment") @db.Decimal(12, 2)
  startDate         DateTime      @map("start_date")
  endDate           DateTime?     @map("end_date")
  paymentDay        Int           @default(1) @map("payment_day")
  isPaid            Boolean       @default(false) @map("is_paid")
  notes             String?

  // Credit card specific fields
  creditLimit       Decimal?      @map("credit_limit") @db.Decimal(12, 2)
  currentBalance    Decimal?      @map("current_balance") @db.Decimal(12, 2)
  minimumPayment    Decimal?      @map("minimum_payment") @db.Decimal(12, 2)
  cutoffDay         Int?          @map("cutoff_day")
  paymentDueDay     Int?          @map("payment_due_day")

  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  payments    BankDebtPayment[]

  @@index([userId])
  @@index([debtType])
  @@map("bank_debts")
}

enum BankDebtType {
  PRESTAMO_PERSONAL
  HIPOTECA
  PRESTAMO_AUTO
  TARJETA_CREDITO
  LINEA_CREDITO
}

model BankDebtPayment {
  id            String   @id @default(cuid())
  bankDebtId    String   @map("bank_debt_id")
  amount        Decimal  @db.Decimal(12, 2)
  principalPaid Decimal  @map("principal_paid") @db.Decimal(12, 2)
  interestPaid  Decimal  @map("interest_paid") @db.Decimal(12, 2)
  paymentDate   DateTime @map("payment_date")
  createdAt     DateTime @default(now()) @map("created_at")

  bankDebt BankDebt @relation(fields: [bankDebtId], references: [id], onDelete: Cascade)

  @@index([bankDebtId])
  @@map("bank_debt_payments")
}
